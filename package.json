{
  "name": "orbis-web-lite",
  "version": "0.1.0-alpha.14",
  "description": "Orbis 单一 AI、多窗口网页实验版",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "rm -rf dist && NODE_ENV=production rspack build -c rspack.config.ts && node scripts/service-worker.mjs",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write .",
    "test": "tsc -p tsconfig.json --noEmit false --outDir .test-build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "onnxruntime-web": "1.31.1",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0"
}
